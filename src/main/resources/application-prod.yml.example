spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/freshtrace?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:root}
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      timeout: 5000ms

elasticsearch:
  enabled: ${ELASTICSEARCH_ENABLED:true}
  uris: ${ELASTICSEARCH_URIS:http://localhost:9200}
  index: ${ELASTICSEARCH_INDEX:freshtrace_product}

# 生产强制外部注入，缺失则启动失败（避免使用开发默认密钥）
jwt:
  secret: ${JWT_SECRET}

aes:
  key: ${AES_KEY}

storage:
  local-dir: ${STORAGE_DIR:uploads}
  base-url: ${STORAGE_BASE_URL:/uploads}

logging:
  level:
    com.freshtrace: info
