spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3307}/freshtrace_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:root}
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      timeout: 5000ms

rocketmq:
  enabled: false

elasticsearch:
  enabled: false

inventory:
  reconciliation:
    enabled: false

fulfillment:
  auto-confirm:
    enabled: false

admin:
  dashboard:
    cache-refresh-enabled: false

product:
  hot:
    enabled: false
